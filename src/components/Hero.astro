---
import Icon from './Icon.astro';
import WhatsAppIcon from './WhatsAppIcon.astro';
import ProductCard from './ProductCard.astro';
import { whatsappUrl } from '../lib/config';
---
<section class="hero section-pad" id="top"><div class="hero-copy"><p class="eyebrow hero-eyebrow">The future of networking</p><h1 class="hero-title">One card.<br /><em>Every connection.</em></h1><p class="hero-description">Meet Suppercard. A smart NFC business card that lets you share your contact details, social links, and digital profile with a simple tap.</p><div class="hero-actions"><a class="button button-dark" href={whatsappUrl} target="_blank" rel="noreferrer"><WhatsAppIcon size={17} />Order your card <Icon name="arrow" /></a><a class="text-link" href="#card">Explore Suppercard <Icon name="down" size={15} /></a></div></div><div class="hero-product reveal-product"><ProductCard /></div><div class="hero-index"><span>01</span><span class="rule"></span><span>05</span></div></section>
