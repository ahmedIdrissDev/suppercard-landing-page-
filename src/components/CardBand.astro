---
import frontCard from '../assets/suppercard front .png';
---
<section class="card-band-wrap section-pad" aria-label="Suppercard product">
	<div class="card-band"><div class="card-band-bg"><img src={frontCard.src} alt="Suppercard NFC card" /></div></div>
	<h2 class="band-headline" aria-label="A smarter way to connect"><span class="word-mask"><span class="band-word">A</span></span> <span class="word-mask"><span class="band-word">smarter</span></span> <span class="word-mask"><span class="band-word">way</span></span> <span class="word-mask"><span class="band-word">to</span></span> <span class="word-mask"><span class="band-word">connect.</span></span></h2>
</section>
